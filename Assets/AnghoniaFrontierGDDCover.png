<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 675" width="100%" height="100%">
  <defs>
    <!-- Background Gradients -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0b0f19" />
      <stop offset="50%" stop-color="#121b2d" />
      <stop offset="100%" stop-color="#05070c" />
    </linearGradient>

    <!-- Celestial Gold Gradient -->
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#e5c07b" />
      <stop offset="50%" stop-color="#f3e0aa" />
      <stop offset="100%" stop-color="#d4a359" />
    </linearGradient>

    <!-- Cyan Energy Gradient -->
    <linearGradient id="energyGrad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#00f2fe" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#4facfe" stop-opacity="0.1"/>
    </linearGradient>

    <!-- Radial Glow -->
    <radialGradient id="centerGlow" cx="50%" cy="45%" r="40%">
      <stop offset="0%" stop-color="#38ef7d" stop-opacity="0.15" />
      <stop offset="40%" stop-color="#11998e" stop-opacity="0.08" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0" />
    </radialGradient>
  </defs>

  <!-- Background Base -->
  <rect width="1200" height="675" fill="url(#bgGrad)" />
  <circle cx="600" cy="300" r="380" fill="url(#centerGlow)" />

  <!-- Geometric Celestial Circles & Grid Lines -->
  <g stroke="#ffffff" stroke-opacity="0.08" stroke-width="1.5" fill="none">
    <circle cx="600" cy="300" r="220" />
    <circle cx="600" cy="300" r="160" stroke-dasharray="6,6" />
    <circle cx="600" cy="300" r="100" />
    <line x1="150" y1="300" x2="1050" y2="300" stroke-opacity="0.05" />
    <line x1="600" y1="50" x2="600" y2="550" stroke-opacity="0.05" />
  </g>

  <!-- Central Celestial Emblem (Divine Principle Motif) -->
  <g transform="translate(600, 300) scale(1.1)">
    <!-- Rotating Diamond Star -->
    <polygon points="0,-75 22,-22 75,0 22,22 0,75 -22,22 -75,0 -22,-22" 
             fill="none" stroke="url(#goldGrad)" stroke-width="2.5" />
    <circle cx="0" cy="0" r="32" fill="#0b1326" stroke="#4facfe" stroke-width="2" />
    <polygon points="0,-18 5,-5 18,0 5,5 0,18 -5,5 -18,0 -5,-5" fill="url(#goldGrad)" />
  </g>

  <!-- Title & Branding -->
  <text x="600" y="210" text-anchor="middle" font-family="'Cinzel', 'Trajan Pro', 'Georgia', serif" font-size="46" font-weight="bold" fill="url(#goldGrad)" letter-spacing="12">
    ANGHONIA
  </text>
  <text x="600" y="425" text-anchor="middle" font-family="'Cinzel', 'Montserrat', 'Helvetica', sans-serif" font-size="28" font-weight="600" fill="#ffffff" letter-spacing="18" fill-opacity="0.9">
    FRONTIER
  </text>

  <text x="600" y="455" text-anchor="middle" font-family="'Helvetica Neue', Arial, sans-serif" font-size="12" font-weight="400" fill="#70829c" letter-spacing="4">
    GRAND FESTIVAL OF THE ALMIGHTY • 50v50 SYSTEM SPECIFICATION
  </text>

  <!-- Outer Frame Border -->
  <rect x="25" y="25" width="1150" height="625" fill="none" stroke="#e5c07b" stroke-opacity="0.3" stroke-width="1.5" />
  <rect x="35" y="35" width="1130" height="605" fill="none" stroke="#ffffff" stroke-opacity="0.05" stroke-width="1" />

  <!-- Corner Accents -->
  <g stroke="url(#goldGrad)" stroke-width="2" fill="none">
    <path d="M 25 55 L 55 25" />
    <path d="M 1175 55 L 1145 25" />
    <path d="M 25 620 L 55 650" />
    <path d="M 1175 620 L 1145 650" />
  </g>

  <!-- Footer Metadata -->
  <text x="60" y="620" font-family="'Courier New', monospace" font-size="12" fill="#8892b0">GAME DESIGN DOCUMENT</text>
  <text x="600" y="620" text-anchor="middle" font-family="'Courier New', monospace" font-size="12" fill="#8892b0">AUTHOR: SALVADOR A. MURO</text>
  <text x="1140" y="620" text-anchor="end" font-family="'Courier New', monospace" font-size="12" fill="#8892b0">SYSTEMS &amp; MECHANICS</text>
</svg>
